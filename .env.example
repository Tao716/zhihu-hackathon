PORT=3000

# Feishu app credentials. Keep these on the server, never in the browser.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# OpenAI-compatible chat completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Set to false to prevent the local sample mode from being used.
ALLOW_SAMPLE_MODE=true
